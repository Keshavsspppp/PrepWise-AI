# Server Configuration
PROJECT_NAME="StudyGenie AI"
DEBUG=true

# MongoDB Configuration
# For local development: mongodb://localhost:27017/studygenie
MONGO_URI="mongodb://localhost:27017/studygenie"

# Security Configuration
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET="your_jwt_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# ChromaDB Configuration
CHROMA_PERSIST_DIR="chroma_db"

# CORS Configuration
# Comma-separated list of allowed origins. For production, set to your app's domain.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
