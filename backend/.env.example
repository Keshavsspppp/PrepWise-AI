# Server Configuration
PROJECT_NAME="PrepWise AI"
# Keep DEBUG=false in production: it returns exception messages and tracebacks to callers.
DEBUG=true

# MongoDB Configuration
# Local development: mongodb://localhost:27017/studygenie
# Docker Compose:    mongodb://mongo:27017/studygenie
MONGO_URI="mongodb://localhost:27017/studygenie"

# Security Configuration
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET="your_jwt_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# CORS Configuration
# Comma-separated list of allowed origins. For production, set to your app's domain.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Public URL of the frontend. Used to build password reset links.
FRONTEND_URL="http://localhost:5173"
